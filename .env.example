# Server & Environment
NODE_ENV=development
PORT=3000
# Keep 127.0.0.1 unless the dashboard sits behind authentication
HOST=127.0.0.1
# Wajib diisi kalau HOST=0.0.0.0 (buka cockpit dari PC lain di jaringan rumah)
COCKPIT_PASSWORD=
# Encrypts the trading wallet key at rest. Leave empty to auto-generate .secrets/master.key
SECRETS_KEY=
WEBHOOK_SECRET=super_secret_webhook_key_12345

# Database & Redis (Local Docker default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whalebot?schema=public"
REDIS_URL="redis://localhost:6379"

# Telegram Bot (grammY)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_IDS=""  # user id Telegram yang boleh tekan tombol

# Whale Watcher APIs
HELIUS_API_KEY=""   # opsional, gratis — lihat setup.md
ALCHEMY_API_KEY=""  # tidak dipakai (bot hanya Solana)
WATCHED_WALLETS=""  # opsional: wallet whale manual, pisahkan koma

# Token Data Aggregator APIs
GOPLUS_API_BASE="https://api.gopluslabs.io"
DEXSCREENER_API_BASE="https://api.dexscreener.com"
BIRDEYE_API_KEY=""
RUGCHECK_API_BASE="https://api.rugcheck.xyz"
JUPITER_API_BASE="https://lite-api.jup.ag"
JUPITER_API_KEY=""

# Trading Execution & Safety
# CRITICAL: Always test with PAPER_TRADING=true first!
PAPER_TRADING=true
CHAIN=solana
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_PRIVATE_KEY="" # Kept empty in repo. Use KMS or secure env in production!
EVM_RPC_URL=""
EVM_PRIVATE_KEY=""

# Trading Parameters
TRADE_AMOUNT_USD=10
SLIPPAGE_BPS=500
MAX_PRIORITY_FEE=0.001
STOP_LOSS_PERCENT=20
TAKE_PROFIT_PERCENT=100
TAKE_PROFIT_STEP=50
APPROVAL_TIMEOUT_SECONDS=120
BUY_TIMEOUT_ACTION=skip

# Scoring Engine
SCORING_THRESHOLD=80
MIN_LIQUIDITY_USD=10000
HARD_FAIL_MIN_LIQUIDITY_USD=5000

# Circuit Breaker (Safety)
MAX_CONSECUTIVE_STOP_LOSS=3
CIRCUIT_BREAKER_WINDOW_MINUTES=60
