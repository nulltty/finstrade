datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Signal {
  id                    String                 @id @default(uuid())
  wallet                String
  chain                 String                 // 'solana' | 'evm'
  tokenAddress          String                 @map("token_address")
  tokenSymbol           String?                @map("token_symbol")
  tokenName             String?                @map("token_name")
  txHash                String                 @unique @map("tx_hash")
  amountUsd             Float?                 @map("amount_usd")
  whaleSolSpent         Float?                 @map("whale_sol_spent")
  whaleEntryPrice       Float?                 @map("whale_entry_price")
  whaleEntryAmount      Float?                 @map("whale_entry_amount")
  whaleTxAt             DateTime?              @map("whale_tx_at")
  decision              String?                // auto_buy, approval_requested, rejected:<reason>
  status                String                 @default("detected") // detected, aggregated, scored, pending_approval, approved, skipped, timeout_expired, executing_buy, bought, failed
  rawTx                 Json?                  @map("raw_tx")
  rawMetrics            Json?                  @map("raw_metrics")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  score                 Score?
  positions             Position[]
  trades                Trade[]
  telegramInteractions  TelegramInteraction[]

  @@map("signals")
}

model Score {
  id                    String                 @id @default(uuid())
  signalId              String                 @unique @map("signal_id")
  totalScore            Float                  @map("total_score")
  isHardFail            Boolean                @default(false) @map("is_hard_fail")
  hardFailReasons       Json?                  @map("hard_fail_reasons")
  breakdown             Json
  createdAt             DateTime               @default(now()) @map("created_at")

  signal                Signal                 @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("scores")
}

model Position {
  id                    String                 @id @default(uuid())
  signalId              String?                @map("signal_id")
  chain                 String
  tokenAddress          String                 @map("token_address")
  tokenSymbol           String?                @map("token_symbol")
  entryPrice            Float                  @map("entry_price")
  entryAmount           Float                  @map("entry_amount")
  entryRawAmount        String?                @map("entry_raw_amount")
  tokenDecimals         Int?                   @map("token_decimals")
  costUsd               Float                  @default(0) @map("cost_usd")
  costSol               Float                  @default(0) @map("cost_sol")
  proceedsUsd           Float?                 @map("proceeds_usd")
  whaleWallet           String?                @map("whale_wallet")
  isPaper               Boolean                @default(true) @map("is_paper")
  peakPrice             Float                  @default(0) @map("peak_price")
  trailingActive        Boolean                @default(false) @map("trailing_active")
  currentPrice          Float                  @map("current_price")
  pnlPercent            Float                  @default(0) @map("pnl_percent")
  highestPnlPercent     Float                  @default(0) @map("highest_pnl_percent")
  nextTpThreshold       Float                  @default(100) @map("next_tp_threshold")
  status                String                 @default("open") // open, closing, closed
  exitPrice             Float?                 @map("exit_price")
  exitReason            String?                @map("exit_reason") // stop_loss, trailing_stop, take_profit_auto, take_profit_approved, take_profit_timeout, whale_exit, manual
  openedAt              DateTime               @default(now()) @map("opened_at")
  closedAt              DateTime?              @map("closed_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  signal                Signal?                @relation(fields: [signalId], references: [id])
  trades                Trade[]
  telegramInteractions  TelegramInteraction[]

  @@map("positions")
}

model Trade {
  id                    String                 @id @default(uuid())
  positionId            String?                @map("position_id")
  signalId              String?                @map("signal_id")
  side                  String                 // 'BUY', 'SELL'
  chain                 String
  tokenAddress          String                 @map("token_address")
  price                 Float
  amount                Float
  totalUsd              Float                  @map("total_usd")
  solAmount             Float?                 @map("sol_amount")
  txHash                String                 @map("tx_hash")
  status                String                 @default("confirmed") // pending, confirmed, failed
  slippageBps           Int?                   @map("slippage_bps")
  priorityFee           Float?                 @map("priority_fee")
  isPaper               Boolean                @default(false) @map("is_paper")
  createdAt             DateTime               @default(now()) @map("created_at")

  position              Position?              @relation(fields: [positionId], references: [id])
  signal                Signal?                @relation(fields: [signalId], references: [id])

  @@map("trades")
}

model TelegramInteraction {
  id                    String                 @id @default(uuid())
  signalId              String?                @map("signal_id")
  positionId            String?                @map("position_id")
  messageId             Int                    @map("message_id")
  chatId                String                 @map("chat_id")
  alertType             String                 @map("alert_type") // buy_approval, take_profit_approval, stop_loss_alert
  actionTaken           String?                @map("action_taken") // approved, skipped, sell, hold, timeout
  respondedAt           DateTime?              @map("responded_at")
  createdAt             DateTime               @default(now()) @map("created_at")

  signal                Signal?                @relation(fields: [signalId], references: [id])
  position              Position?              @relation(fields: [positionId], references: [id])

  @@map("telegram_interactions")
}

model AuditLog {
  id                    String                 @id @default(uuid())
  action                String
  reason                String
  payload               Json?
  createdAt             DateTime               @default(now()) @map("created_at")

  @@map("audit_logs")
}

model WatchedWallet {
  id                    String                 @id @default(uuid())
  address               String                 @unique
  chain                 String                 @default("solana")
  label                 String?
  tags                  String[]               @default([])
  winRate               Float?                 @map("win_rate")
  totalPnlUsd           Float?                 @map("total_pnl_usd")
  isActive              Boolean                @default(true) @map("is_active")
  lastScannedAt         DateTime?              @map("last_scanned_at")
  lastTxHash            String?                @map("last_tx_hash")
  discoveredVia         String?                @map("discovered_via")
  profileStatus         String                 @default("candidate") @map("profile_status") // candidate, qualified, rejected
  profileReason         String?                @map("profile_reason")
  tradesAnalyzed        Int                    @default(0) @map("trades_analyzed")
  closedTrades          Int                    @default(0) @map("closed_trades")
  wins                  Int                    @default(0)
  losses                Int                    @default(0)
  realizedPnlSol        Float                  @default(0) @map("realized_pnl_sol")
  avgHoldMinutes        Float?                 @map("avg_hold_minutes")
  whaleScore            Float                  @default(0) @map("whale_score")
  lastProfiledAt        DateTime?              @map("last_profiled_at")
  signalsTriggered      Int                    @default(0) @map("signals_triggered")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("watched_wallets")
}

model BotSetting {
  id                    String                 @id @default("default")
  paperTrading          Boolean                @default(true) @map("paper_trading")
  chain                 String                 @default("solana")
  tradeAmountUsd        Float                  @default(25.0) @map("trade_amount_usd")
  maxOpenPositions      Int                    @default(5) @map("max_open_positions")
  maxDailySpendUsd      Float                  @default(200.0) @map("max_daily_spend_usd")
  slippageBps           Int                    @default(500) @map("slippage_bps")
  maxPriorityFee        Float                  @default(0.001) @map("max_priority_fee")

  stopLossPercent       Float                  @default(20.0) @map("stop_loss_percent")
  takeProfitPercent     Float                  @default(100.0) @map("take_profit_percent")
  takeProfitStep        Float                  @default(50.0) @map("take_profit_step")
  approvalTimeoutSec    Int                    @default(120) @map("approval_timeout_sec")
  buyTimeoutAction      String                 @default("skip") @map("buy_timeout_action")

  scoringThreshold      Float                  @default(75.0) @map("scoring_threshold")
  minLiquidityUsd       Float                  @default(10000.0) @map("min_liquidity_usd")
  hardFailMinLiquidity  Float                  @default(5000.0) @map("hard_fail_min_liquidity")

  autoScanIntervalSec   Int                    @default(10) @map("auto_scan_interval_sec")
  autoDiscoveryEnabled  Boolean                @default(true) @map("auto_discovery_enabled")
  autoDiscoveryIntervalMin Int                 @default(60) @map("auto_discovery_interval_min")

  autoTradeMode         Boolean                @default(true) @map("auto_trade_mode")
  trailingStopPercent   Float                  @default(15.0) @map("trailing_stop_percent")
  trailingArmPercent    Float                  @default(20.0) @map("trailing_arm_percent")
  copySellEnabled       Boolean                @default(true) @map("copy_sell_enabled")
  positionSizeMode      String                 @default("fixed_usd") @map("position_size_mode") // fixed_usd, percent_balance
  positionSizePercent   Float                  @default(5.0) @map("position_size_percent")
  solReserve            Float                  @default(0.02) @map("sol_reserve")
  minWhaleWinRate       Float                  @default(60.0) @map("min_whale_win_rate")
  minWhaleClosedTrades  Int                    @default(5) @map("min_whale_closed_trades")
  minWhaleBuyUsd        Float                  @default(300.0) @map("min_whale_buy_usd")
  maxSignalAgeSec       Int                    @default(300) @map("max_signal_age_sec")
  maxPriceImpactPct     Float                  @default(5.0) @map("max_price_impact_pct")
  maxRoundTripLossPct   Float                  @default(15.0) @map("max_round_trip_loss_pct")

  mySolanaWallet        String?                @map("my_solana_wallet")
  mySolanaPrivateKey    String?                @map("my_solana_private_key")
  telegramBotToken      String?                @map("telegram_bot_token")
  telegramChatId        String?                @map("telegram_chat_id")

  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("bot_settings")
}


